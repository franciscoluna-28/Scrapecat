# === MANDATORY (open-source / Postgres mode) ===
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Generate with: openssl rand -base64 32
# Used to encrypt API keys at rest (BYOK feature).
# REQUIRED only when POSTGRES/DATABASE_URL is used. NOT needed in demo mode.
ENCRYPTION_KEY=your_base64_32_byte_key

# === OPTIONAL ===
# Server config
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL with pgvector). Defaults to the local docker-compose `db` service.
DATABASE_URL=postgres://scrapecat:scrapecat@localhost:5432/scrapecat

# === DEMO MODE (opt-in; does not affect the open-source default) ===
# Set DEMO_MODE=true AND leave DATABASE_URL empty to run the self-contained demo:
# no Postgres, in-memory storage, bundled demo repos seeded at boot, keys read
# from env (BYOK blocked), keyword search (EMBEDDING_ENABLED=false).
# DEMO_MODE=true
# DATABASE_URL=
# ENCRYPTION_KEY=
# Demo model defaults to the FREE OpenRouter model nvidia/nemotron-3-ultra-550b-a55b:free
# (no credit card needed; you still need OPENROUTER_API_KEY). Override with AI_MODEL.
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Embedding generation requires an API key + Postgres; disable it in demo mode.
# EMBEDDING_ENABLED=false
# Repos pre-bundled for the demo (JSON array). Run `pnpm demo:data` to
# regenerate the bundled commit snapshots under src/demo/data/.
# DEMO_REPOS=[{"owner":"formbricks","repo":"formbricks"},{"owner":"shadcn-ui","repo":"ui"}]

# Override the default AI model (default: google/gemma-4-26b-a4b-it:free)
AI_MODEL=google/gemma-4-26b-a4b-it:free

# GitHub token — used to clone repo archives for commit ingestion
# Get one at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token

# Local git archive cache for batch commit ingestion (default: repos/)
REPO_ARCHIVE_DIR=repos

# Small LLM that verifies diffs and writes code-grounded summaries (default: a
# large-context OpenRouter model). Batches DIFF_SUMMARY_BATCH_SIZE commits/call.
DIFF_SUMMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
DIFF_SUMMARY_BATCH_SIZE=50
# Set to false to skip the LLM guardrail and use structural fallbacks only
DIFF_SUMMARY_ENABLED=true
