# === MANDATORY ===
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Generate with: openssl rand -base64 32
# Used to encrypt API keys at rest (BYOK feature).
ENCRYPTION_KEY=your_base64_32_byte_key

# === OPTIONAL ===
# Server config
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL with pgvector). Defaults to the local docker-compose `db` service.
DATABASE_URL=postgres://scrapecat:scrapecat@localhost:5432/scrapecat

# Override the default AI model (default: mimo-v2.6-flash)
AI_MODEL=mimo-v2.6-flash

# GitHub token (OPTIONAL).
# Self-hosted: any token (or classic PAT) used to clone repo archives.
# Demo: not required. Commits are read from the public GitHub REST API
# anonymously (60 req/hr per IP) — plenty because the demo serves from the
# database and only calls GitHub to fill gaps. For a higher limit, use a
# *fine-grained* PAT with Repository access = "Public repositories
# (read-only)" and no other permissions; GitHub then enforces that it can
# never read your private repos or account data.
# Create at https://github.com/settings/personal-access-tokens
# GITHUB_TOKEN=your_github_token

# Local git archive cache for batch commit ingestion (default: repos/).
# Ignored in demo mode (DEMO_MODE=true), which uses the GitHub API instead.
REPO_ARCHIVE_DIR=repos

# === DEMO PROFILE (optional) ===
# DEMO_MODE=true switches commit ingestion to the GitHub REST API (no git
# binary, no disk) so the backend runs on serverless hosts, and hardens every
# GitHub call to public-only (never /user or /user/repos, so the token owner's
# identity and private repos are never exposed to visitors). Ingestion is
# limited to main/master (or the repo default). See docs/demo.md.
# It also implies DEMO_RESTRICT_KEYS (visitors cannot add their own API keys).
# DEMO_MODE=true
# Allow/deny visitors connecting new repositories. Default true. Workflow:
# leave it on for the first run to connect + ingest the repos you want to ship
# (picking a branch triggers ingestion into Postgres), then set it to "false"
# to lock the app to that pre-ingested set for the hackathon demo.
# ALLOW_ADD_REPOS=false
# Explicitly restrict BYOK without the rest of the demo profile:
# DEMO_RESTRICT_KEYS=true

# Rate limits (per-IP)
RATE_LIMIT_MAX=240
CHAT_RATE_LIMIT_MAX=20

# Embedding model (default: openai/text-embedding-3-small)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_ENABLED=true

# Small LLM that verifies diffs and writes code-grounded summaries (default: a
# large-context OpenRouter model). Batches DIFF_SUMMARY_BATCH_SIZE commits/call.
DIFF_SUMMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
DIFF_SUMMARY_BATCH_SIZE=50
# Set to false to skip the LLM guardrail and use structural fallbacks only
DIFF_SUMMARY_ENABLED=true
