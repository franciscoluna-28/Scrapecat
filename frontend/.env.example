# URL of the backend API server
# In local dev: http://localhost:4000
# In Docker dev: http://backend-dev:4000 (for SSR) or http://localhost:4000 (for client-side)
NEXT_PUBLIC_API_URL=http://localhost:4000

# OPTIONAL — demo deployment only. Set to "true" to enable the demo experience:
# onboarding popup, default onboarding onto the demo repo, canned questions,
# safety line, and BYOK hidden. The open-source product ignores this.
NEXT_PUBLIC_DEMO_MODE=false

# Controls the "Connect repository" / "New chat" flow. Default true. Set to
# "false" to lock the UI to the repos already ingested (match the backend's
# ALLOW_ADD_REPOS for the hackathon demo).
# NEXT_PUBLIC_ALLOW_ADD_REPOS=false