{
  "name": "scrapecat",
  "private": true,
  "scripts": {
    "dev": "concurrently --names backend,frontend \"docker compose up db backend-dev\" \"pnpm --filter @scrapecat/frontend dev\"",
    "build": "pnpm --filter @scrapecat/frontend build && pnpm --filter @scrapecat/backend build",
    "lint": "pnpm --filter @scrapecat/frontend lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @scrapecat/backend test:integration",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "codegen": "npx tsx scripts/codegen.ts",
    "db:generate": "pnpm --filter @scrapecat/backend db:generate",
    "db:migrate": "pnpm --filter @scrapecat/backend db:migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "msw",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@types/node": "^20",
    "concurrently": "^9.1.0"
  }
}
