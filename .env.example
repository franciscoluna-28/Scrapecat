GITHUB_TOKEN=your_github_token
GROQ_API_KEY=your_groq_api_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=file:data/dev.db

# Cloudflare R2 — used to host PR screenshots on our own infra.
# This avoids broken images when sharing reports with stakeholders
# who don't have GitHub authentication, and prevents hotlinking limits.
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET_NAME=reports
R2_PUBLIC_URL=https://<your-custom-domain>.com/reports