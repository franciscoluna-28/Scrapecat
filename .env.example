# === MANDATORY ===
# Get a free key at https://openrouter.ai/keys
# Used by all AI report generation and refinement routes
OPENROUTER_API_KEY=your_openrouter_api_key

# === OPTIONAL ===
# Without this, unauthenticated GitHub requests are limited to 60/hr.
# With a token: 5000/hr. Get one at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token

# === FULL APP ONLY (not needed for /demo routes) ===
# These are only required if you deploy the full-featured app (DB-backed reports).
# DATABASE_URL=file:data/dev.db
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_BUCKET_NAME=reports
# R2_PUBLIC_URL=https://<your-custom-domain>.com/reports
